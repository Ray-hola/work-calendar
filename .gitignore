# Runtime data (accounts, database, WAL) must never be committed
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
data/initial-accounts.txt
data/*.log

# Stray runtime logs in the repo root. The service manager used to redirect
# stdout/stderr to ./out.log and ./err.log next to the code; a manual
# `python server.py > out.log` would land in the same place. Never commit either.
/*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*

# Local secrets and tunnel credentials
*.pem
*.json
!package.json
.env
.env.*
.cloudflared/
run-windows.local.ps1
*.local.ps1

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
